-## end choice
-CONFIG_LOCK_DOWN_IN_EFI_SECURE_BOOT=y
+# SECURITY_LOCKDOWN_LSM selects MODULE_SIG whenever modules are enabled.
+# The initial unsigned product cannot truthfully retain EFI-triggered
+# lockdown without also designing the module/UEFI trust chain.
+# CONFIG_SECURITY_LOCKDOWN_LSM is not set
