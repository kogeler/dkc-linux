--- a/arch/x86/Kconfig.cpu
+++ b/arch/x86/Kconfig.cpu
@@ -246,6 +246,30 @@
 
 	  If unsure, say N.
 
+choice
+	prompt "DKC x86-64 compiler baseline"
+	depends on X86_64 && !X86_NATIVE_CPU
+	default DKC_X86_64_BASELINE_GENERIC
+	help
+	  Select the psABI micro-architecture baseline for ordinary
+	  64-bit kernel C and Rust code. The architecture Makefile still
+	  disables implicit MMX/SSE/AVX generation; explicit kernel FPU
+	  contexts remain controlled by their target-specific flags.
+
+config DKC_X86_64_BASELINE_GENERIC
+	bool "Generic x86-64"
+
+config DKC_X86_64_BASELINE_V2
+	bool "x86-64-v2"
+
+config DKC_X86_64_BASELINE_V3
+	bool "x86-64-v3"
+
+config DKC_X86_64_BASELINE_V4
+	bool "x86-64-v4"
+
+endchoice
+
 config X86_GENERIC
 	bool "Generic x86 support"
 	depends on X86_32
--- a/arch/x86/Makefile
+++ b/arch/x86/Makefile
@@ -73,9 +73,11 @@
 #
 #    https://gcc.gnu.org/bugzilla/show_bug.cgi?id=53383
 #
-KBUILD_CFLAGS += -mno-sse -mno-mmx -mno-sse2 -mno-3dnow -mno-avx -mno-sse4a
+X86_CFLAGS_NO_SIMD := -mno-sse -mno-mmx -mno-sse2 -mno-3dnow -mno-avx -mno-sse4a
+X86_RUSTFLAGS_NO_SIMD := -Ctarget-feature=-sse,-sse2,-sse3,-ssse3,-sse4.1,-sse4.2,-avx,-avx2
+KBUILD_CFLAGS += $(X86_CFLAGS_NO_SIMD)
 KBUILD_RUSTFLAGS += --target=$(objtree)/scripts/target.json
-KBUILD_RUSTFLAGS += -Ctarget-feature=-sse,-sse2,-sse3,-ssse3,-sse4.1,-sse4.2,-avx,-avx2
+KBUILD_RUSTFLAGS += $(X86_RUSTFLAGS_NO_SIMD)
 
 # The target.json file is not available when invoking rustc-option, so use the
 # built-in target when checking whether flags are supported instead.
@@ -168,9 +170,24 @@
         KBUILD_CFLAGS += -march=native
         KBUILD_RUSTFLAGS += -Ctarget-cpu=native
 else
-        KBUILD_CFLAGS += -march=x86-64 -mtune=generic
-        KBUILD_RUSTFLAGS += -Ctarget-cpu=x86-64 -Ztune-cpu=generic
-endif
+        DKC_X86_64_TARGET := x86-64
+ifeq ($(CONFIG_DKC_X86_64_BASELINE_V2),y)
+        DKC_X86_64_TARGET := x86-64-v2
+else ifeq ($(CONFIG_DKC_X86_64_BASELINE_V3),y)
+        DKC_X86_64_TARGET := x86-64-v3
+else ifeq ($(CONFIG_DKC_X86_64_BASELINE_V4),y)
+        DKC_X86_64_TARGET := x86-64-v4
+endif
+        KBUILD_CFLAGS += -march=$(DKC_X86_64_TARGET) -mtune=generic
+        KBUILD_RUSTFLAGS += -Ctarget-cpu=$(DKC_X86_64_TARGET) -Ztune-cpu=generic
+endif
+
+        # A psABI baseline implies SIMD features. Reassert the kernel's
+        # no-SIMD policy after -march/-Ctarget-cpu so compiler ordering
+        # cannot enable vector state in ordinary kernel code. Per-object
+        # CC_FLAGS_FPU are appended later by scripts/Makefile.lib.
+        KBUILD_CFLAGS += $(X86_CFLAGS_NO_SIMD)
+        KBUILD_RUSTFLAGS += $(X86_RUSTFLAGS_NO_SIMD)
 
         KBUILD_CFLAGS += -mno-red-zone
         KBUILD_CFLAGS += -mcmodel=kernel
