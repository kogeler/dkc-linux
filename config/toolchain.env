# The kernel build toolchain, selected in this one place.
#
# Make includes this file, and the kernel build image receives it as podman
# build arguments. Everything else derives from these values: package names,
# the Kbuild LLVM=-<major> selection, the overlay, the headers' runtime
# dependencies, and every audit and client check. The exact package versions
# that a choice resolves to are recorded and hashed by the toolchain lock.

# The clang, lld, and llvm major. It must be one that Debian 13 ships, because
# the generated headers package depends on it at runtime and every DKMS user
# has to be able to install it.
LLVM_MAJOR=22

# The Debian suite whose newest rustc and rust-src build the kernel's Rust code.
RUSTC_SUITE=trixie-backports
