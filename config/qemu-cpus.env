# Versioned QEMU CPU models used for positive and negative flavor checks.
# The v2 and v3 models intentionally predate spec-ctrl: that mitigation feature
# is detected independently at boot and is not part of either psABI baseline.
# Optional PCID and five-level paging are disabled because neither belongs to
# the psABI levels under test and nested KVM commonly masks them.
DKC_QEMU_MACHINE='q35'
DKC_QEMU_CPU_V2='Nehalem-v1'
DKC_QEMU_CPU_V3='Haswell-v2,-pcid'
DKC_QEMU_CPU_V4='EPYC-Genoa-v1,-pcid,-la57'
