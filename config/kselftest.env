# Bounded exact-source kernel selftest profile used in every flavor VM.
#
# Every target below must build.  Only the explicit collection:test entries
# run in the guest; this keeps broad subsystem coverage without running
# benchmarks, destructive tests, or hardware-specific suites.
DKC_KSELFTEST_PROFILE_KIND='qualification'
DKC_KSELFTEST_TARGETS='capabilities clone3 core filesystems/epoll futex ipc landlock membarrier mincore mount_setattr net/af_unix openat2 pidfd proc ptrace rlimits rseq seccomp signal splice syscall_user_dispatch timens timers uevent x86'
DKC_KSELFTEST_TESTS='capabilities:test_execve clone3:clone3_clear_sighand clone3:clone3_set_tid core:close_range_test core:unshare_test filesystems/epoll:epoll_wakeup_test futex:run.sh ipc:msgque landlock:fs_test membarrier:membarrier_test_multi_thread mincore:mincore_selftest mount_setattr:mount_setattr_test net/af_unix:scm_rights net/af_unix:scm_pidfd openat2:resolve_test pidfd:pidfd_open_test pidfd:pidfd_wait pidfd:pidfd_info_test proc:proc-maps-race proc:proc-self-syscall ptrace:get_syscall_info ptrace:peeksiginfo ptrace:vmaccess-only rlimits:rlimits-per-userns rseq:basic_percpu_ops_test seccomp:seccomp_bpf signal:sas splice:default_file_splice_read.sh syscall_user_dispatch:sud_test timens:timens timers:posix_timers uevent:uevent_filtering x86:sigreturn_64 x86:corrupt_xstate_header_64 x86:avx_64'

# These tests require AVX/OSXSAVE, which begins at the v3 baseline.  They are
# built into every portable tree but are recorded as baseline-omitted on v2.
DKC_KSELFTEST_V3_TESTS='x86:corrupt_xstate_header_64 x86:avx_64'

# A selected test may run for at most three minutes.  The complete profile has
# an independent fifteen-minute ceiling, including slow software-emulated VMs.
DKC_KSELFTEST_PER_TEST_TIMEOUT=180
DKC_KSELFTEST_AGGREGATE_TIMEOUT=900

# Builtin requirements are exact.  Enabled requirements accept either y or m;
# the guest can load the corresponding shipped module before the profile runs.
DKC_KSELFTEST_REQUIRED_BUILTIN='AF_UNIX_OOB AUDIT CGROUPS CGROUP_SCHED CHECKPOINT_RESTORE EPOLL EVENTFD EXPERT FUTEX GENERIC_ENTRY INET IPC_NS IPV6 KEYS MPTCP MPTCP_IPV6 NET NET_NS PID_NS POSIX_TIMERS PROC_FS RSEQ SECCOMP SECCOMP_FILTER SECURITY SECURITY_LANDLOCK SHMEM SIGNALFD SYSFS SYSVIPC TIME_NS TIMERFD TMPFS TMPFS_XATTR UNIX USER_NS UTS_NS X86_64'
DKC_KSELFTEST_REQUIRED_ENABLED='OVERLAY_FS UNIX_DIAG'
