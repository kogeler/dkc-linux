{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dkc.invalid/schemas/repository-signing-request.schema.json",
  "title": "DKC repository signing request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "generation",
    "issued_epoch",
    "release_date",
    "valid_until",
    "primary_fingerprint",
    "signing_subkey_fingerprints",
    "active_signing_subkey_fingerprint",
    "source_version",
    "source_dsc_sha256",
    "dkc_version",
    "dkc_revision",
    "build_policy_sha256",
    "lto_mode",
    "build_id",
    "retained_series",
    "retention_mode",
    "meta_packages",
    "package_count",
    "source_count",
    "gc_queue",
    "artifacts"
  ],
  "properties": {
    "schema": { "const": "dkc.repository-signing-request.v1" },
    "status": { "const": "READY" },
    "generation": { "type": "integer", "minimum": 0 },
    "issued_epoch": { "type": "integer", "minimum": 1 },
    "release_date": { "type": "string", "minLength": 1 },
    "valid_until": { "type": "string", "minLength": 1 },
    "primary_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "signing_subkey_fingerprints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/fingerprint" }
    },
    "active_signing_subkey_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "source_version": { "type": "string", "minLength": 1 },
    "source_dsc_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "dkc_version": { "type": "string", "minLength": 1 },
    "dkc_revision": { "type": "integer", "minimum": 1 },
    "build_policy_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "lto_mode": { "enum": ["none", "thin", "full"] },
    "build_id": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
    "retained_series": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "integer", "minimum": 0 }
      }
    },
    "retention_mode": { "enum": ["series", "series-size"] },
    "retention_max_bytes": { "type": "integer", "minimum": 1 },
    "meta_packages": {
      "type": "object",
      "minProperties": 6,
      "maxProperties": 6,
      "propertyNames": {
        "pattern": "^dkc-linux-(base|image|headers)-(v2|v3)-amd64$"
      },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "package_count": { "type": "integer", "minimum": 19 },
    "source_count": { "type": "integer", "minimum": 2 },
    "gc_queue": {
      "type": "array",
      "items": { "$ref": "#/$defs/gc_entry" }
    },
    "previous_publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication_id", "generation"],
      "properties": {
        "publication_id": { "type": "string", "pattern": "^[0-9a-z-]{8,64}$" },
        "generation": { "type": "integer", "minimum": 0 }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9A-F]{40}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "sha256", "size", "media_type", "cache_class"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^(pool|dists|keys)/[A-Za-z0-9][A-Za-z0-9._+~/-]*$"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 0 },
        "media_type": { "type": "string", "minLength": 1 },
        "cache_class": { "enum": ["immutable", "mutable"] }
      }
    },
    "gc_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "sha256", "size", "reason", "tombstoned"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string", "minLength": 1 },
        "tombstoned": { "const": true }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "retention_mode": { "const": "series-size" } } },
      "then": { "required": ["retention_max_bytes"] },
      "else": { "not": { "required": ["retention_max_bytes"] } }
    }
  ]
}
