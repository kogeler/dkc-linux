{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dkc.invalid/schemas/site-build-1.json",
  "title": "Audited public documentation site build",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "site_url", "source_revision", "objects"],
  "properties": {
    "schema": { "const": "dkc.site-build.v1" },
    "site_url": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+/$" },
    "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 400,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "sha256", "size", "content_type", "cache_control"],
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*\\.(css|html|js|json|png|svg|txt|xml)$"
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 1, "maximum": 4194304 },
          "content_type": {
            "enum": [
              "application/json",
              "application/xml",
              "image/png",
              "image/svg+xml",
              "text/css; charset=utf-8",
              "text/html; charset=utf-8",
              "text/javascript; charset=utf-8",
              "text/plain; charset=utf-8"
            ]
          },
          "cache_control": { "const": "public, max-age=0, must-revalidate" }
        }
      }
    }
  }
}
